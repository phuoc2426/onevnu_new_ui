# =========================================================
# ONEVNU monorepo .gitignore
# Keep source/configuration files in Git; ignore only generated,
# local-machine, build-cache and secret/signing artifacts.
# =========================================================

# OS / editors
.DS_Store
*.swp
*.swo
*~
.atom/
.buildlog/
.history/
.svn/
.vscode/
.idea/
*.iml
*.ipr
*.iws

# Logs / temporary files
*.log
logs/
*.tmp
tmp/
*.class
*.pyc

# Dart / Flutter / Pub generated state
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/doc/api/

# FVM SDK cache. Keep .fvmrc in Git so the Flutter version is reproducible.
.fvm/

# Build outputs
build/
**/build/
dist/
out/
coverage/

# Generated Dart sources
# *.g.dart
# *.freezed.dart
# *.mocks.dart
# *.config.dart

# Android generated/local/signing files
.gradle/
**/.gradle/
**/.kotlin/
android/captures/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore
*.apk
*.aab
*.ap_
*.dex

# iOS / Xcode generated files
**/DerivedData/
**/xcuserdata/
*.xcuserstate
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/engine/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id
**/ios/Flutter/flutter_assets/
**/ios/build/
**/ios/Runner.xcworkspace/

# IMPORTANT: iOS source/configuration files below must stay in Git.
# They contain deployment target, permissions, capabilities and build settings.
!one_vnu_appstore/ios/Podfile
!one_vnu_appstore/ios/Podfile.lock
!one_vnu_appstore/ios/Flutter/AppFrameworkInfo.plist
!one_vnu_appstore/ios/Flutter/Debug.xcconfig
!one_vnu_appstore/ios/Flutter/Release.xcconfig
!one_vnu_appstore/ios/Runner/Info.plist
!one_vnu_appstore/ios/Runner/AppDelegate.swift
!one_vnu_appstore/ios/Runner/*.entitlements
!one_vnu_appstore/ios/Runner.xcodeproj/project.pbxproj
!one_vnu_appstore/ios/Runner.xcodeproj/xcshareddata/**

# Also keep the same files when one_vnu_appstore itself is used as repo root.
!ios/Podfile
!ios/Podfile.lock
!ios/Flutter/AppFrameworkInfo.plist
!ios/Flutter/Debug.xcconfig
!ios/Flutter/Release.xcconfig
!ios/Runner/Info.plist
!ios/Runner/AppDelegate.swift
!ios/Runner/*.entitlements
!ios/Runner.xcodeproj/project.pbxproj
!ios/Runner.xcodeproj/xcshareddata/**

# macOS generated files
**/macos/Pods/
**/macos/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/build/
**/macos/Runner.xcworkspace/

# Web / Windows / Linux generated files
web/.dart_tool/
windows/flutter/ephemeral/
windows/build/
linux/flutter/ephemeral/
linux/build/

# Secrets / certificates / provisioning profiles
.env
.env.*
*.pem
*.p12
*.key
*.mobileprovision
android/key.properties
android/app/*.jks
android/app/*.keystore

# Firebase generated Dart config (project policy: generated locally/CI)
# firebase_options.dart

# Archives / binary build artifacts
*.zip
*.rar
*.7z
*.tar
*.gz
*.aar

# Indoor SDK / temporary caches
**/cache.tar.gz
*.xcframework/**/cache.tar.gz
temp_aar_check/
inmapz_backup/
CODE_BUNDLE.txt
